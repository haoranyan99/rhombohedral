# ============================================================
# NERSC / Perlmutter CPU build notes
# ============================================================

# Preferred:
#   ./compile_nersc.sh

# Manual module setup:
module purge
module load craype-x86-milan
module load craype-network-ofi
module load libfabric/1.22.0
module load PrgEnv-gnu/8.5.0
module load cray-mpich/8.1.30

# Build all production MPI executables into bin/
make clean
make -j 8

# Or build one target:
make calculate_fermi
make calculate_chi
make calculate_orbital_moment
make calculate_berry_curvature

# Example interactive runs:
srun -n 4 -c 1 --cpu_bind=cores ./bin/calculate_fermi config.json
srun -n 4 -c 1 --cpu_bind=cores ./bin/calculate_chi config.json
srun -n 4 -c 1 --cpu_bind=cores ./bin/calculate_orbital_moment config.json
srun -n 4 -c 1 --cpu_bind=cores ./bin/calculate_berry_curvature config.json
