# ============================================================
# Common include flags
# ============================================================

# Shared include set used by the commands below:
#   -I.
#   -I./include
#   -I./include/eigen-3.4.0
#   -I./Common
#   -I./PhysStruct
#   -I./Source
#   -I./MeasureEngines
#   -I./Util


# ============================================================
# Recommended parallel build for chi (MPI)
# ============================================================

# calculate_chi parallel version
mpicxx -std=c++17 -O2 -DNDEBUG -DUSE_MPI \
  -I. \
  -I./include \
  -I./include/eigen-3.4.0 \
  -I./Common \
  -I./PhysStruct \
  -I./Source \
  -I./MeasureEngines \
  -I./Util \
  Executables/calculate_chi.cpp \
  -o calculate_chi

# Run with multiple ranks:
mpiexec -n 4 ./calculate_chi config.json


