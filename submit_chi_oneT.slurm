#!/bin/bash
# Base script generated by NERSC Batch Script Generator on
# https://iris.nersc.gov/utils/jobscript

#SBATCH -N 4
#SBATCH -C cpu
#SBATCH -q regular
#SBATCH -J {{JOB_NAME}}
#SBATCH --mail-user=haoranyan99@gmail.com
#SBATCH --mail-type=ALL
#SBATCH -A m3706
#SBATCH -t 0:30:00

#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1

# ---- modules (IMPORTANT) ----
module purge

# Minimal runtime stack (match your compile env as needed)
module load craype-x86-milan
module load craype-network-ofi
module load libfabric/1.22.0
module load PrgEnv-gnu/8.5.0
module load cray-mpich/8.1.30

# This fixes: libcudart.so.12 not found
module load cudatoolkit/12.4

echo "[INFO] Job start : $(date)"
echo "[INFO] Job name  : $SLURM_JOB_NAME"
echo "[INFO] Host      : $(hostname)"
echo "[INFO] Work dir  : $(pwd)"
echo "[INFO] Nodes     : ${SLURM_JOB_NUM_NODES:-unknown}"
echo "[INFO] Tasks     : ${SLURM_NTASKS:-unknown}"
echo "[INFO] Tasks/node: ${SLURM_NTASKS_PER_NODE:-unknown}"
echo "[INFO] Cpus/task : ${SLURM_CPUS_PER_TASK:-unknown}"
echo "[INFO] Node list : ${SLURM_JOB_NODELIST:-unknown}"
echo "[INFO] Modules:"
module list 2>&1

# OpenMP settings:
export OMP_NUM_THREADS=1
export OMP_PLACES=threads
export OMP_PROC_BIND=spread

# ---- timing ----
t0=$SECONDS

# ---- sanity print ----
echo "[INFO] EXE : {{EXE_ABS}}"
echo "[INFO] CFG : {{CFG_ABS}}"

# run
# (Use Slurm-provided task counts; srun will launch across 4 nodes)
srun -n "${SLURM_NTASKS}" -c "${SLURM_CPUS_PER_TASK}" --cpu_bind=cores {{EXE_ABS}} {{CFG_ABS}}

dt=$((SECONDS - t0))
echo "[INFO] Job end   : $(date)"
printf "[INFO] Elapsed   : %02d:%02d:%02d (hh:mm:ss)\n" $((dt/3600)) $(((dt%3600)/60)) $((dt%60))