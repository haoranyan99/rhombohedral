{
  "io": {
    "data_dir": "data",
    "model_para": "Source/Parameters/RG_para.json"
  },

  "structure_and_kpath": {
    "model": "sk",
    "GMKG": { "Nk_seg": 200 }
  },

  "bareband": {
    "model": "sk",
    "Dfield_eV": -0.012,
    "GMKG": { "Nk_seg": 1000, "frac_local": 0.10 },
    "localK_MKKp": { "Nk_seg": 1000, "frac_local": 0.10 },
    "output_suffix": "_Nk1000"
  },

  "calculate_dos": {
    "model": "sk",
    "DfieldList_eV": { "min": -0.01, "max": 0, "num": 1 },
    "kmesh": { "type": "BZ", "Nk": 200, "dk_frac": 0.004 },
    "T_K": 6.4,
    "dos": { "e_low": 0.5000, "e_high": 0.8000, "num_e": 3001, "eta": 0.002 },
    "output_suffix": "Nk200_D-0.01"
  },

  "calculate_fermi": {
    "model": "sk",
    "Dfield_eV": -0.01,
    "magnetic_field": {
      "BList_T": {
        "min": 5,
        "max": 10,
        "num": 1
      },
      "g_factor": 2.0,
      "orbital_derivative_dk": 1e-5
    },

    "kmesh": {
      "type": "b1b2",
      "Nk": 60,
      "dk_frac": 0.00125
    },

    "output_suffix": "auto",

    "temperatureList_K": {
      "min": 6.4,
      "max": 8.0,
      "num": 1
    },

    "muList_eV": {
      "min": 0.55,
      "max": 0.85,
      "num": 601  
    }
  },

  "calculate_orbital_moment": {
    "model": "sk",
    "mode": "kmesh",
    "Dfield_eV": -0.01,
    "derivative_dk": 1e-5,
    "magnetic_field": {
      "BList_T": { "min": 1, "max": 5, "num": 2 }
    },

    "kmesh": {
      "type": "b1b2",
      "Nk": 50,
      "dk_frac": 0.00125
    },

    "kpath": {
      "type": "localK_MKKp",
      "Nk_seg": 1000,
      "frac_local": 0.10
    },

    "bandList": [4, 5, 6],
    "output_suffix": "auto"
  },

  "calculate_berry_curvature": {
    "model": "sk",
    "mode": "kpath",
    "Dfield_eV": -0.01,
    "derivative_dk": 1e-5,

    "kmesh": {
      "type": "b1b2",
      "Nk": 50,
      "dk_frac": 0.00125
    },

    "kpath": {
      "type": "localK_MKKp",
      "Nk_seg": 1000,
      "frac_local": 0.10
    },

    "bandList": [4, 5, 6],
    "output_suffix": "auto"
  },

  "calculate_magnetic_band": {
    "model": "sk",
    "mode": "kpath",
    "Dfield_eV": -0.01,
    "magnetic_field": {
      "BList_T": { "min": 0, "max": 10, "num": 11 },
      "g_factor": 2.0,
      "orbital_derivative_dk": 1e-5
    },

    "kpath": {
      "type": "localK_MKKp",
      "Nk_seg": 1000,
      "frac_local": 0.10
    },

    "bandList": [4, 5, 6],
    "output_suffix": "auto"
  },

  "calculate_magnetic_dos": {
    "model": "sk",
    "Dfield_eV": -0.01,
    "magnetic_field": {
      "BList_T": { "min": 0, "max": 10, "num": 11 },
      "g_factor": 2.0,
      "orbital_derivative_dk": 1e-5
    },

    "kmesh": {
      "type": "b1b2",
      "Nk": 60,
      "dk_frac": 0.00125
    },

    "T_K": 6.4,
    "dos": {
      "e_low": 0.45,
      "e_high": 0.85,
      "num_e": 2001,
      "eta": 0.001
    },

    "output_suffix": "auto"
  },

  "calculate_chi": {
    "model": "sk",
    "boundary": "open",
    "Dfield_eV": -0.01,
    "eta": 1e-4,

    "iq": 1,
    "jq": 2,
    "use_form_factor": true,
    "diagonal_band_only": false,

    "temperatureList_K": {
      "min": 6.4,
      "max": 6.4,
      "num": 1   
    },

    "muList_eV": {
      "min": 0.550,
      "max": 0.850,
      "num": 301   
    },

    "fermi_patch_path": "data/D-0.010/B0T",
    "output_suffix": "auto"
  }
}
